<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dd="using:MonacoLabs.DragDrop">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E6EA" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#667085" />
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ChipBorderBrush" Color="#DCE0E5" />
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#F2F4F7" />
                    <SolidColorBrush x:Key="SlotBackgroundBrush" Color="#FAFBFC" />
                    <SolidColorBrush x:Key="SlotBorderBrush" Color="#C3C8D0" />
                    <SolidColorBrush x:Key="TagBackgroundBrush" Color="#FDECEA" />
                    <SolidColorBrush x:Key="TagForegroundBrush" Color="#B42318" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#18191C" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#202226" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232529" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#33363C" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#98A2B3" />
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#2B2E33" />
                    <SolidColorBrush x:Key="ChipBorderBrush" Color="#3B3F46" />
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#34373D" />
                    <SolidColorBrush x:Key="SlotBackgroundBrush" Color="#1F2124" />
                    <SolidColorBrush x:Key="SlotBorderBrush" Color="#4A4F57" />
                    <SolidColorBrush x:Key="TagBackgroundBrush" Color="#3D2120" />
                    <SolidColorBrush x:Key="TagForegroundBrush" Color="#F97066" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush
                x:Key="AccentFillBrush"
                Opacity="0.12"
                Color="{DynamicResource SystemAccentColor}" />
        </ResourceDictionary>
    </Styles.Resources>

    <!--  Typography  -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.subtle">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.8" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>

    <Style Selector="TabStrip TabStripItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="Margin" Value="0,0,20,0" />
    </Style>

    <!--  Surfaces  -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.card ListBox, Border.card TreeView">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.card ListBoxItem">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource TileBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{DynamicResource TileBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="Border.tag">
        <Setter Property="Background" Value="{DynamicResource TagBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TagForegroundBrush}" />
    </Style>
    <Style Selector="PathIcon.stat">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>

    <!--  Draggable chip  -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.chip:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.chip:dragging">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!--  Drop slot  -->
    <Style Selector="Border.slot">
        <Setter Property="Background" Value="{DynamicResource SlotBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="62" />
    </Style>
    <Style Selector="Border.slot Rectangle.slot-outline">
        <Setter Property="Stroke" Value="{DynamicResource SlotBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeDashArray" Value="4,3" />
        <Setter Property="RadiusX" Value="10" />
        <Setter Property="RadiusY" Value="10" />
    </Style>
    <Style Selector="Border.slot.filled Rectangle.slot-outline">
        <Setter Property="Stroke" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="StrokeDashArray" Value="{x:Null}" />
    </Style>
    <Style Selector="Border.slot TextBlock.slot-hint">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.slot:dropover TextBlock.slot-hint">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.grip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.grip > TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style Selector="Border.grip:pointerover">
        <Setter Property="Background" Value="{DynamicResource TileBackgroundBrush}" />
    </Style>
    <Style Selector="Border.slot:dragging">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="ToggleButton.lock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ToggleButton.lock TextBlock.locked">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.lock:checked TextBlock.locked">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ToggleButton.lock:checked TextBlock.unlocked">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>

    <!--  Drag and drop visuals  -->
    <Style Selector="dd|DropHighlightAdorner">
        <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="dd|DropInsertionAdorner">
        <Setter Property="LineBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="dd|DragPreviewAdorner">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="dd|DragPreviewAdorner:nodrop">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="dd|DragPreviewAdorner:remove">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="BorderBrush" Value="{DynamicResource TagForegroundBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</Styles>
