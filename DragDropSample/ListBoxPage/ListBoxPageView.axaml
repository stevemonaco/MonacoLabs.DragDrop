<UserControl
    x:Class="DragDropSample.Views.ListBoxPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cdd="using:DragDropSample.CustomDragDrop"
    xmlns:con="using:DragDropSample.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="using:MonacoLabs.DragDrop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="using:DragDropSample.Resources"
    xmlns:vm="using:DragDropSample.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:ListBoxPageViewModel"
    mc:Ignorable="d">
    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:WorkerViewModel">
            <Grid
                Margin="0,2"
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="4">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    ToolTip.Tip="Salary">
                    <PathIcon Classes="stat vflip" Data="{x:Static res:AppIcons.Gold}" />
                    <TextBlock Text="{Binding Salary}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="12">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        ToolTip.Tip="Mining">
                        <PathIcon Classes="stat vflip" Data="{x:Static res:AppIcons.Mining}" />
                        <TextBlock Text="{Binding MiningProficiency}" />
                    </StackPanel>
                    <StackPanel
                        IsVisible="{Binding CraftingProficiency, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Orientation="Horizontal"
                        Spacing="4"
                        ToolTip.Tip="Crafting">
                        <PathIcon Classes="stat vflip" Data="{x:Static res:AppIcons.Crafting}" />
                        <TextBlock Text="{Binding CraftingProficiency}" />
                    </StackPanel>
                    <StackPanel
                        IsVisible="{Binding CombatProficiency, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Orientation="Horizontal"
                        Spacing="4"
                        ToolTip.Tip="Combat">
                        <PathIcon Classes="stat vflip" Data="{x:Static res:AppIcons.Combat}" />
                        <TextBlock Text="{Binding CombatProficiency}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Classes="subtle"
                    FontSize="12"
                    Text="{Binding DislikedWorkers, Converter={x:Static con:AppConverters.DislikedWorkers}}" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="*,20,*">
        <!--  Available Workers  -->
        <Border Classes="card">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="card-title" Text="Available workers" />
                    <Border Classes="pill">
                        <TextBlock Text="{Binding AvailableWorkers.Count}" />
                    </Border>
                </StackPanel>
                <ListBox
                    x:Name="workers"
                    Grid.Row="1"
                    ItemsSource="{Binding AvailableWorkers}">
                    <dd:DragDrop.DragOperation>
                        <dd:CollectionDragOperation InteractionIds="app:mining, app:crafting, app:combat" PayloadCollection="{Binding AvailableWorkers}" />
                    </dd:DragDrop.DragOperation>
                </ListBox>

                <!--  Each team's DropOperation.ErrorMessage, bound without touching the adorner  -->
                <Border
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Classes="tag"
                    IsVisible="{Binding #rejection.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock x:Name="rejection" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Converter="{x:Static con:AppConverters.FirstNonEmpty}">
                                <Binding Path="#miningTeam.((cdd:WorkerDropOperation)(dd:DragDrop.DropOperation)).ErrorMessage" />
                                <Binding Path="#craftingTeam.((cdd:WorkerDropOperation)(dd:DragDrop.DropOperation)).ErrorMessage" />
                                <Binding Path="#combatTeam.((cdd:WorkerDropOperation)(dd:DragDrop.DropOperation)).ErrorMessage" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Grid
            Grid.Column="2"
            RowDefinitions="*,16,*,16,*">
            <!--  Mining Team  -->
            <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="stat vflip" Data="{x:Static res:AppIcons.Mining}" />
                        <TextBlock Classes="card-title" Text="Mining team" />
                        <Border Classes="pill">
                            <TextBlock Text="{Binding MiningBudgetRemaining, StringFormat=Budget {0}}" />
                        </Border>
                        <Border Classes="pill">
                            <TextBlock Text="{Binding MiningTeamProficiency, StringFormat=Proficiency {0}}" />
                        </Border>
                    </StackPanel>
                    <ListBox
                        x:Name="miningTeam"
                        Grid.Row="1"
                        ItemsSource="{Binding MiningTeam}">
                        <dd:DragDrop.DropOperation>
                            <cdd:WorkerDropOperation InteractionIds="app:mining" PayloadTarget="{Binding MiningTeam}" />
                        </dd:DragDrop.DropOperation>
                    </ListBox>
                </Grid>
            </Border>

            <!--  Crafting Team  -->
            <Border Grid.Row="2" Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="stat vflip" Data="{x:Static res:AppIcons.Crafting}" />
                        <TextBlock Classes="card-title" Text="Crafting team" />
                        <Border Classes="pill">
                            <TextBlock Text="{Binding CraftingBudgetRemaining, StringFormat=Budget {0}}" />
                        </Border>
                        <Border Classes="pill">
                            <TextBlock Text="{Binding CraftingTeamProficiency, StringFormat=Proficiency {0}}" />
                        </Border>
                    </StackPanel>
                    <ListBox
                        x:Name="craftingTeam"
                        Grid.Row="1"
                        ItemsSource="{Binding CraftingTeam}">
                        <dd:DragDrop.DropOperation>
                            <cdd:WorkerDropOperation InteractionIds="app:crafting" PayloadTarget="{Binding CraftingTeam}" />
                        </dd:DragDrop.DropOperation>
                    </ListBox>
                </Grid>
            </Border>

            <!--  Combat Team  -->
            <Border Grid.Row="4" Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Classes="stat vflip" Data="{x:Static res:AppIcons.Combat}" />
                        <TextBlock Classes="card-title" Text="Combat team" />
                        <Border Classes="pill">
                            <TextBlock Text="{Binding CombatBudgetRemaining, StringFormat=Budget {0}}" />
                        </Border>
                        <Border Classes="pill">
                            <TextBlock Text="{Binding CombatTeamProficiency, StringFormat=Proficiency {0}}" />
                        </Border>
                    </StackPanel>
                    <ListBox
                        x:Name="combatTeam"
                        Grid.Row="1"
                        ItemsSource="{Binding CombatTeam}">
                        <dd:DragDrop.DropOperation>
                            <cdd:WorkerDropOperation InteractionIds="app:combat" PayloadTarget="{Binding CombatTeam}" />
                        </dd:DragDrop.DropOperation>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
