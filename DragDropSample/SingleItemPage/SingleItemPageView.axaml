<UserControl
    x:Class="DragDropSample.Views.SingleItemPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cdd="using:DragDropSample.CustomDragDrop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="using:MonacoLabs.DragDrop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DragDropSample.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    x:DataType="vm:SingleItemPageViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="MenuItemTemplate" x:DataType="vm:MenuItemViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Classes="tile">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Text="{Binding Emoji}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="subtle" Text="{Binding Price, StringFormat={}{0:$0.00}}" />
                </StackPanel>
                <Border
                    Grid.Column="2"
                    Classes="tag"
                    IsVisible="{Binding IsSoldOut}">
                    <TextBlock Text="Sold out" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ItemsControl.menu">
            <Setter Property="Margin" Value="-4" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ItemsControl.menu Border.chip">
            <Setter Property="Margin" Value="4" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid VerticalAlignment="Top" ColumnDefinitions="3*,20,2*">
            <!--  Menu (drag sources)  -->
            <Border VerticalAlignment="Top" Classes="card">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="card-title" Text="Menu" />
                        <TextBlock Classes="subtle" Text="Each card is an ItemDragOperation whose payload falls back to its DataContext. Menu cards only allow Copy." />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-header" Text="MEALS" />
                        <ItemsControl Classes="menu" ItemsSource="{Binding Meals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MenuItemViewModel">
                                    <Border Classes="chip">
                                        <dd:DragDrop.DragOperation>
                                            <dd:ItemDragOperation AllowedEffects="Copy" InteractionIds="meal" />
                                        </dd:DragDrop.DragOperation>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MenuItemTemplate}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-header" Text="DRINKS" />
                        <ItemsControl Classes="menu" ItemsSource="{Binding Drinks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MenuItemViewModel">
                                    <Border Classes="chip">
                                        <dd:DragDrop.DragOperation>
                                            <dd:ItemDragOperation AllowedEffects="Copy" InteractionIds="drink" />
                                        </dd:DragDrop.DragOperation>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MenuItemTemplate}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Orders (drop targets that are also drag sources)  -->
            <Border
                Grid.Column="2"
                VerticalAlignment="Top"
                Classes="card">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="card-title" Text="Your table" />
                        <TextBlock Classes="subtle" Text="Each slot is an ItemDropOperation and an ItemDragOperation bound TwoWay to the same property, with SwapOnDrop and RemoveOnDropOutside." />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Guests}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuestOrderViewModel">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Classes="section-header"
                                            Text="{Binding Name}" />
                                        <ToggleButton
                                            Grid.Column="1"
                                            Classes="lock"
                                            IsChecked="{Binding IsLocked}"
                                            ToolTip.Tip="Locked orders can't be changed by dragging">
                                            <Panel>
                                                <TextBlock Classes="unlocked" Text="🔓 Unlocked" />
                                                <TextBlock Classes="locked" Text="🔒 Locked" />
                                            </Panel>
                                        </ToggleButton>
                                    </Grid>

                                    <Border Classes="slot" Classes.filled="{Binding Meal, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <dd:DragDrop.DragOperation>
                                            <dd:ItemDragOperation
                                                AllowedEffects="Move,Copy"
                                                CanDrag="{Binding !IsLocked}"
                                                InteractionIds="meal"
                                                Payload="{Binding Meal}"
                                                RemoveOnDropOutside="True"
                                                RequiresDragHandle="True"
                                                SwapOnDrop="True" />
                                        </dd:DragDrop.DragOperation>
                                        <dd:DragDrop.DropOperation>
                                            <cdd:MenuItemDropOperation InteractionIds="meal" PayloadTarget="{Binding Meal}" />
                                        </dd:DragDrop.DropOperation>
                                        <Panel>
                                            <Rectangle Classes="slot-outline" />
                                            <TextBlock
                                                Classes="slot-hint"
                                                IsVisible="{Binding Meal, Converter={x:Static ObjectConverters.IsNull}}"
                                                Text="Drop a meal here" />
                                            <Grid
                                                Margin="4,8,6,8"
                                                ColumnDefinitions="Auto,*,Auto"
                                                IsVisible="{Binding Meal, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Border
                                                    Classes="grip"
                                                    dd:DragDrop.IsDragHandle="True"
                                                    ToolTip.Tip="Drag to move, hold Ctrl to copy">
                                                    <TextBlock Text="⠿" />
                                                </Border>
                                                <ContentControl
                                                    Grid.Column="1"
                                                    Content="{Binding Meal}"
                                                    ContentTemplate="{StaticResource MenuItemTemplate}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="icon"
                                                    Command="{Binding RemoveMealCommand}"
                                                    Content="✕"
                                                    IsEnabled="{Binding !IsLocked}"
                                                    ToolTip.Tip="Remove meal" />
                                            </Grid>
                                        </Panel>
                                    </Border>

                                    <Border Classes="slot" Classes.filled="{Binding Drink, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <dd:DragDrop.DragOperation>
                                            <dd:ItemDragOperation
                                                AllowedEffects="Move,Copy"
                                                CanDrag="{Binding !IsLocked}"
                                                InteractionIds="drink"
                                                Payload="{Binding Drink}"
                                                RemoveOnDropOutside="True"
                                                RequiresDragHandle="True"
                                                SwapOnDrop="True" />
                                        </dd:DragDrop.DragOperation>
                                        <dd:DragDrop.DropOperation>
                                            <cdd:MenuItemDropOperation InteractionIds="drink" PayloadTarget="{Binding Drink}" />
                                        </dd:DragDrop.DropOperation>
                                        <Panel>
                                            <Rectangle Classes="slot-outline" />
                                            <TextBlock
                                                Classes="slot-hint"
                                                IsVisible="{Binding Drink, Converter={x:Static ObjectConverters.IsNull}}"
                                                Text="Drop a drink here" />
                                            <Grid
                                                Margin="4,8,6,8"
                                                ColumnDefinitions="Auto,*,Auto"
                                                IsVisible="{Binding Drink, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Border
                                                    Classes="grip"
                                                    dd:DragDrop.IsDragHandle="True"
                                                    ToolTip.Tip="Drag to move, hold Ctrl to copy">
                                                    <TextBlock Text="⠿" />
                                                </Border>
                                                <ContentControl
                                                    Grid.Column="1"
                                                    Content="{Binding Drink}"
                                                    ContentTemplate="{StaticResource MenuItemTemplate}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="icon"
                                                    Command="{Binding RemoveDrinkCommand}"
                                                    Content="✕"
                                                    IsEnabled="{Binding !IsLocked}"
                                                    ToolTip.Tip="Remove drink" />
                                            </Grid>
                                        </Panel>
                                    </Border>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="subtle" Text="Subtotal" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Classes="subtle"
                                            Text="{Binding Subtotal, StringFormat={}{0:$0.00}}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border
                        Padding="0,14,0,0"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Total" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding Total, StringFormat={}{0:$0.00}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
